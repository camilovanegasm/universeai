rules_version = '2';

// Reglas de seguridad de Punti.
//
// La idea: cada persona solo toca su propio perfil, y dentro de él solo los
// campos que el juego necesita, con límites. Todo lo que no esté en la lista
// (premium, rol, lo que se agregue después) queda cerrado para el usuario.
// Solo el admin puede leer a todos y cambiar cualquier campo.
//
// Si algo se rompe, la versión anterior está en referencias/firestore.rules.anterior.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Quién es quién ----------

    // El admin se reconoce por su correo, y solo si Google/Firebase lo verificó:
    // alguien que se registre con ese correo sin poder abrirlo no pasa.
    function esAdmin() {
      return request.auth != null
        && request.auth.token.email == 'camilovanegasm@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function esDueno(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Miembro de Punti Club: solo el admin pone `premium` en el perfil (el
    // usuario no puede tocar ese campo, ver cambioDelJuego).
    function esPremium() {
      return request.auth != null
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('premium', false) == true;
    }

    // ---------- Fechas ----------
    // La app guarda el día como "YYYY-MM-DD" en hora UTC. Aquí se arma la misma
    // fecha con el reloj del servidor, que el usuario no puede adelantar.

    function dosCifras(n) {
      return n < 10 ? '0' + string(n) : string(n);
    }

    function fecha(t) {
      return string(t.year()) + '-' + dosCifras(t.month()) + '-' + dosCifras(t.day());
    }

    // Margen de 2 horas por si el reloj del teléfono está un poco corrido
    // justo alrededor de la medianoche UTC.
    function esHoy(f) {
      return f == fecha(request.time)
        || f == fecha(request.time - duration.value(2, 'h'))
        || f == fecha(request.time + duration.value(2, 'h'));
    }

    // ---------- Números del juego ----------
    // Salen de contenido/ajustes, que el admin cambia en la pestaña AJUSTES.
    // Si el documento no existe, se usan los de siempre (5 de gasolina,
    // 20 XP por lección). Firebase cobra una sola lectura por petición
    // aunque se consulte varias veces.

    function juego() {
      let ruta = /databases/$(database)/documents/contenido/ajustes;
      return exists(ruta) ? get(ruta).data.get('juego', {}) : {};
    }

    function tanque() {
      return juego().get('gasolinaMaxima', 5);
    }

    function xpMaximo() {
      return juego().get('xpMaximo', 20);
    }

    // ¿El XP pasó de `a` a `b` cruzando el umbral de algún rango? Los umbrales
    // salen de Ajustes (xpRango2...xpRango10); los números de respaldo son los
    // de siempre (ver ajustes.ts).
    function cruza(a, b, u) {
      return a < u && b >= u;
    }
    function subioDeRango(a, b) {
      let j = juego();
      return cruza(a, b, j.get('xpRango2', 40)) || cruza(a, b, j.get('xpRango3', 120))
        || cruza(a, b, j.get('xpRango4', 250)) || cruza(a, b, j.get('xpRango5', 450))
        || cruza(a, b, j.get('xpRango6', 700)) || cruza(a, b, j.get('xpRango7', 1000))
        || cruza(a, b, j.get('xpRango8', 1400)) || cruza(a, b, j.get('xpRango9', 1900))
        || cruza(a, b, j.get('xpRango10', 2600));
    }

    // ---------- Reglas del juego ----------

    // La gasolina se llama `corazones` en la base de datos por compatibilidad.
    // El mismo día solo puede bajar, salvo con una recarga de minijuego válida.
    // En un día nuevo se recarga, hasta el tanque.
    function gasolinaValida(antes, despues) {
      let mismoDia = despues.get('ultimaActividad', '') == antes.get('ultimaActividad', '');
      return despues.corazones is number
        && despues.corazones >= 0
        && (mismoDia
            ? (despues.corazones <= antes.corazones || recargaJuegoValida(antes, despues))
            : despues.corazones <= tanque());
    }

    // Recarga por ganar un minijuego (ver recargarConJuego en progreso.ts).
    // Todo se comprueba con el reloj del servidor y los números de Ajustes:
    //  - el contador del día sube de a 1 (o arranca en 1 en un día nuevo) y
    //    no pasa del tope diario;
    //  - el día del contador es hoy y nunca vuelve atrás (si pudiera ir y
    //    venir entre dos fechas, el contador se reiniciaría sin fin);
    //  - pasó el tiempo mínimo desde la recarga anterior;
    //  - la gasolina sube como mucho lo que da un juego, sin pasar del tanque,
    //    y solo en el mismo día de actividad.
    function recargaJuegoValida(antes, despues) {
      let j = juego();
      let tope = j.get('recargasJuegoDia', 3);
      let diaAntes = antes.get('recargaJuegoDia', '');
      let dia = despues.get('recargaJuegoDia', '');
      let n = despues.get('recargasJuego', -1);
      let ultima = antes.get('ultimaRecargaJuego', null);
      return tope > 0
        && dia is string && esHoy(dia) && dia >= diaAntes
        && n is int
        && (dia == diaAntes ? n == antes.get('recargasJuego', 0) + 1 : n == 1)
        && n <= tope
        && despues.get('ultimaRecargaJuego', null) == request.time
        && (ultima == null
            || request.time > ultima + duration.value(int(j.get('segundosEntreRecargas', 30)), 's'))
        && despues.get('ultimaActividad', '') == antes.get('ultimaActividad', '')
        && despues.corazones is number
        && antes.corazones is number
        && despues.corazones > antes.corazones
        && despues.corazones <= antes.corazones + j.get('gasolinaPorJuego', 1)
        && despues.corazones <= tanque();
    }

    // Laboratorio en vivo (fase C1.3, ver src/app/api/laboratorio/route.ts).
    // Cada transmisión a la IA suma 1 en el perfil (`labUsos` del día `labDia`)
    // Y 1 en el contador de toda la app (laboratorio/{dia}), en la MISMA
    // escritura: una no pasa sin la otra. Así:
    //  - nadie pasa de su tope del día (Club: labUsosClub; resto: labUsosPiloto);
    //  - el contador no se reinicia (el día solo avanza, igual que las recargas);
    //  - la app entera no pasa de labUsosDia (0 = Laboratorio en vivo apagado).
    function labValido(antes, despues) {
      let j = juego();
      let dia = despues.get('labDia', '');
      let diaAntes = antes.get('labDia', '');
      let n = despues.get('labUsos', -1);
      let tope = antes.get('premium', false) == true ? j.get('labUsosClub', 40) : j.get('labUsosPiloto', 15);
      let contador = /databases/$(database)/documents/laboratorio/$(dia);
      return dia is string && esHoy(dia) && dia >= diaAntes
        && n is int
        && (dia == diaAntes ? n == antes.get('labUsos', 0) + 1 : n == 1)
        && n <= tope
        && j.get('labUsosDia', 2000) > 0
        && getAfter(contador).data.get('usos', -1) == (exists(contador) ? get(contador).data.usos + 1 : 1);
    }

    // Lo que guarda la app al completar una lección (ver completarLeccion).
    function entradaValida(e) {
      return e is map
        && e.keys().hasOnly(['completada', 'combustible', 'xpGanado', 'tiempoSegundos', 'ultimaVez'])
        && e.completada == true
        && e.combustible in [1, 2, 3]
        && e.xpGanado is int && e.xpGanado >= 0 && e.xpGanado <= xpMaximo()
        && e.tiempoSegundos is int && e.tiempoSegundos >= 0
        && e.ultimaVez == request.time;
    }

    // Las reglas no pueden recorrer una lista para saber qué lección cambió,
    // así que la app lo dice en `ultimaLeccionId` y aquí se comprueba que
    // sea exactamente esa, y solo esa.
    function progresoValido(antes, despues) {
      let id = despues.get('ultimaLeccionId', '');
      return despues.progreso is map
        && id is string && id.size() > 0 && id.size() <= 60
        && despues.progreso.diff(antes.progreso).affectedKeys().hasOnly([id])
        && entradaValida(despues.progreso[id]);
    }

    function cambioDelJuego(antes, despues) {
      let cambios = despues.diff(antes).affectedKeys();
      return cambios.hasOnly([
          'xp', 'racha', 'corazones', 'ultimaActividad', 'ultimaLeccion',
          'ultimaLeccionId', 'progreso', 'idioma', 'bienvenidaVista', 'premioRangoDesde',
          'recargasJuego', 'recargaJuegoDia', 'ultimaRecargaJuego',
          'labUsos', 'labDia'
        ])
        // El contador del Laboratorio en vivo: solo sube de a 1, junto con el
        // contador de la app (ver labValido).
        && (!cambios.hasAny(['labUsos', 'labDia']) || labValido(antes, despues))
        // Los campos de la recarga con minijuegos solo cambian juntos, en una
        // recarga válida (que además exige que la gasolina suba).
        && (!cambios.hasAny(['recargasJuego', 'recargaJuegoDia', 'ultimaRecargaJuego'])
            || (cambios.hasAny(['corazones']) && recargaJuegoValida(antes, despues)))
        // Premio de subir de rango (gasolina ilimitada unas horas): solo con la
        // hora del servidor y solo si en esta misma escritura el XP cruzó el
        // umbral de un rango. Nadie se lo puede regalar.
        && (!cambios.hasAny(['premioRangoDesde'])
            || (despues.premioRangoDesde == request.time
                && juego().get('horasPremioRango', 6) > 0
                && subioDeRango(antes.get('xp', 0), despues.xp)))
        // Idioma: solo los dos que existen.
        && (!cambios.hasAny(['idioma']) || despues.idioma in ['es', 'en'])
        // La bienvenida se marca una vez y no se desmarca.
        && (!cambios.hasAny(['bienvenidaVista']) || despues.bienvenidaVista == true)
        // XP: solo sube, y como mucho lo que da la mejor lección + el bono.
        && (!cambios.hasAny(['xp'])
            || (despues.xp is int && despues.xp > antes.xp && despues.xp <= antes.xp + xpMaximo()))
        // La fecha de actividad siempre es la de hoy según el servidor.
        // y solo avanza: si pudiera ir y volver entre dos fechas (el margen de
        // 2 horas deja dos fechas válidas cerca de la medianoche), cada cambio
        // de "día" llenaría el tanque sin límite.
        && (!cambios.hasAny(['ultimaActividad'])
            || (despues.ultimaActividad is string && esHoy(despues.ultimaActividad)
                && despues.ultimaActividad > antes.get('ultimaActividad', '')))
        && (!cambios.hasAny(['ultimaLeccion'])
            || (despues.ultimaLeccion is string && esHoy(despues.ultimaLeccion)
                && despues.ultimaLeccion > antes.get('ultimaLeccion', '')))
        && (!cambios.hasAny(['corazones']) || gasolinaValida(antes, despues))
        // La racha solo cambia con la primera lección completada de un día
        // nuevo: sube 1 o vuelve a empezar en 1.
        && (!cambios.hasAny(['racha'])
            || (cambios.hasAny(['ultimaLeccion'])
                && (despues.racha == antes.racha + 1 || despues.racha == 1)))
        // Progreso: una lección por escritura, con la forma exacta que
        // escribe la app. Así nadie llena su perfil de datos inventados.
        && (!cambios.hasAny(['progreso']) || progresoValido(antes, despues))
        && (!cambios.hasAny(['ultimaLeccionId']) || cambios.hasAny(['progreso']));
    }

    // Un perfil nuevo tiene que empezar en cero, sin campos extra y sin
    // textos gigantes.
    function perfilNuevoValido(d) {
      return d.keys().hasOnly(['nombre', 'email', 'xp', 'corazones', 'racha', 'progreso', 'creadoEn'])
        && d.nombre is string && d.nombre.size() <= 80
        && d.email is string && d.email.size() <= 200
        && d.email == request.auth.token.get('email', '')
        && d.xp == 0
        && d.corazones is number && d.corazones > 0 && d.corazones <= tanque()
        && d.racha == 0
        && d.progreso == {}
        && d.creadoEn == request.time;
    }

    // ---------- Bitácora del piloto (fase C2) ----------
    // usuarios/{uid}/bitacora/{id}. Solo el dueño la lee y escribe (ni el
    // admin lee la de otros). Cada tipo tiene un id fijo y una forma exacta,
    // con largos máximos (ver src/lib/bitacora.ts). Las notas libres van de
    // nota-0 a nota-199: así nadie llena su cuenta sin límite.

    function textoBilingue(t, n) {
      return t is map && t.keys().hasOnly(['es', 'en'])
        && t.es is string && t.en is string && t.es.size() <= n && t.en.size() <= n;
    }

    function idSeguro(s) {
      return s is string && s.matches('[a-z0-9-]{1,80}');
    }

    function textoEntre(s, min, max) {
      return s is string && s.size() >= min && s.size() <= max;
    }

    function bitacoraValida(id, d) {
      return d.fecha == request.time && (
        (id.matches('concepto-[a-z0-9-]{1,80}')
          && d.keys().hasOnly(['tipo', 'concepto', 'titulo', 'definicion', 'frase', 'mision', 'mundo', 'fecha'])
          && d.tipo == 'concepto' && idSeguro(d.concepto) && id == 'concepto-' + d.concepto
          && textoBilingue(d.titulo, 120) && textoBilingue(d.definicion, 400)
          && textoEntre(d.frase, 1, 280) && idSeguro(d.mision) && idSeguro(d.mundo))
        || (id.matches('prompt-[a-z0-9-]{1,80}-b[0-9]{2}')
          && d.keys().hasOnly(['tipo', 'texto', 'etiqueta', 'piezas', 'aprobado', 'idioma', 'mision', 'mundo', 'fecha'])
          && d.tipo == 'prompt' && textoEntre(d.texto, 1, 600) && textoBilingue(d.etiqueta, 80)
          && textoEntre(d.piezas, 0, 400) && d.aprobado is bool && d.idioma in ['es', 'en']
          && idSeguro(d.mision) && idSeguro(d.mundo) && id.matches('prompt-' + d.mision + '-b[0-9]{2}'))
        || (id.matches('ficha-[a-z0-9-]{1,80}')
          && d.keys().hasOnly(['tipo', 'titulo', 'xp', 'combustible', 'transmisiones', 'conAyuda', 'mision', 'mundo', 'fecha'])
          && d.tipo == 'ficha' && textoBilingue(d.titulo, 120)
          && d.xp is int && d.xp >= 0 && d.xp <= 100 && d.combustible in [1, 2, 3]
          && d.transmisiones is int && d.transmisiones >= 0 && d.transmisiones <= 50
          && d.conAyuda is int && d.conAyuda >= 0 && d.conAyuda <= 30
          && idSeguro(d.mision) && idSeguro(d.mundo) && id == 'ficha-' + d.mision)
        || (id.matches('nota-(0|[1-9][0-9]?|1[0-9][0-9])')
          && d.keys().hasOnly(['tipo', 'texto', 'fecha'])
          && d.tipo == 'nota' && textoEntre(d.texto, 1, 1200))
      );
    }

    // ---------- Perfiles ----------

    match /usuarios/{usuarioId} {
      // Leer: el dueño su propio perfil; el admin, todos (incluida la lista).
      allow read: if esDueno(usuarioId) || esAdmin();

      allow create: if esDueno(usuarioId) && perfilNuevoValido(request.resource.data);

      // El admin puede cambiar cualquier campo (gasolina, premium...).
      // El dueño, solo lo que el juego necesita, con los límites de arriba.
      allow update: if esAdmin()
        || (esDueno(usuarioId) && cambioDelJuego(resource.data, request.resource.data));

      // Nadie borra perfiles desde la app: borrar y volver a crear serviría
      // para reiniciar la gasolina.
      allow delete: if false;

      // La Bitácora del piloto (ver bitacoraValida arriba).
      match /bitacora/{entrada} {
        allow read, delete: if esDueno(usuarioId);
        allow create, update: if esDueno(usuarioId) && bitacoraValida(entrada, request.resource.data);
      }
    }

    // ---------- Contenido (mundos y lecciones) ----------
    // Lo publicado lo lee cualquiera, incluso sin cuenta: la portada muestra
    // los mundos antes de registrarse. Solo el admin lo cambia.
    match /contenido/{documento} {
      allow read: if true;
      allow write: if esAdmin();
    }
    // Las lecciones de los mundos del Club se guardan con `club: true` y solo
    // las leen los miembros del Club y el admin. Las demás, cualquiera.
    match /lecciones/{leccionId} {
      allow read: if resource == null
        || resource.data.get('club', false) != true
        || esAdmin()
        || esPremium();
      allow write: if esAdmin();
    }

    // ---------- Punti Club: lista de espera ----------
    // Cada persona con cuenta se anota una vez (el id es su uid) con su propio
    // correo. Nadie más ve la lista, salvo el admin.
    function anotacionValida(d) {
      return d.keys().hasOnly(['email', 'plan', 'moneda', 'idioma', 'creadoEn'])
        && d.email == request.auth.token.get('email', '')
        && d.email is string && d.email.size() <= 200
        && d.plan in ['mensual', 'anual', 'fundador']
        && d.moneda in ['COP', 'USD']
        && d.idioma in ['es', 'en']
        && d.creadoEn == request.time;
    }
    match /listaEspera/{usuarioId} {
      allow read: if esDueno(usuarioId) || esAdmin();
      allow create, update: if esDueno(usuarioId) && anotacionValida(request.resource.data);
      allow delete: if esDueno(usuarioId) || esAdmin();
    }
    // ---------- Misiones (formato nuevo, fase C1) ----------
    // La misión publicada la lee cualquiera, salvo las de mundos del Club
    // (`club: true`): esas solo miembros y el admin, igual que las lecciones.
    // Solo el admin publica. Las versiones (el historial de cada publicación)
    // solo las ve y escribe el admin.
    match /misiones/{misionId} {
      allow read: if resource == null
        || resource.data.get('club', false) != true
        || esAdmin()
        || esPremium();
      allow write: if esAdmin();
      match /versiones/{version} {
        allow read, write: if esAdmin();
      }
    }

    // ---------- Laboratorio en vivo: contador de toda la app ----------
    // Un documento por día (laboratorio/2026-09-24 → { usos }). Solo sube de a
    // 1, nunca pasa de labUsosDia y siempre junto con el contador del perfil
    // de quien transmite (usoPareado). Nadie lo borra ni lo reinicia.
    match /laboratorio/{dia} {
      function usoPareado(d) {
        let yo = /databases/$(database)/documents/usuarios/$(request.auth.uid);
        let antes = get(yo).data;
        let despues = getAfter(yo).data;
        return despues.get('labDia', '') == d
          && despues.get('labUsos', -1)
             == (antes.get('labDia', '') == d ? antes.get('labUsos', 0) + 1 : 1);
      }
      allow read: if request.auth != null;
      allow create: if request.auth != null && esHoy(dia)
        && request.resource.data.keys().hasOnly(['usos'])
        && request.resource.data.usos == 1
        && juego().get('labUsosDia', 2000) >= 1
        && usoPareado(dia);
      allow update: if request.auth != null && esHoy(dia)
        && request.resource.data.keys().hasOnly(['usos'])
        && request.resource.data.usos == resource.data.usos + 1
        && request.resource.data.usos <= juego().get('labUsosDia', 2000)
        && usoPareado(dia);
      allow delete: if false;
    }

    // Los borradores del editor: solo el admin los ve.
    match /borradores/{documento} {
      allow read, write: if esAdmin();
    }
  }
}
