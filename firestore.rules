rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuario solo puede leer y escribir su propio documento de perfil
    // (XP, corazones, racha, progreso), identificado por su ID de Firebase Auth.
    match /usuarios/{usuarioId} {
      allow read, write: if request.auth != null && request.auth.uid == usuarioId;
    }
  }
}
